DATABASE_URL=postgresql+asyncpg://rag:rag123@127.0.0.1:5432/ragdb

# ===== LLM (Groq — free tier, OpenAI-compatible) =====
# Create a free key at https://console.groq.com/keys (no card needed)
LLM_API_KEY=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
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_MODEL_FAST=qwen/qwen3.8-27b
LLM_CTX=6144
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=320

# ===== Embeddings =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_MAX_LEN=1024

# ===== Reranker =====
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MAX_LEN=512

# ===== Retrieval =====
TOP_K_DENSE=25
TOP_K_SPARSE=25
TOP_K_HYBRID=12
TOP_K_RERANK=4
RRF_K=60
HNSW_EF_SEARCH=80

# ===== Cache =====
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL=3600

# ===== Auth (dashboard username + password, both compulsory) =====
ADMIN_USERNAME=admin
ADMIN_TOKEN=123456
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# ===== Tender database (MySQL) =====
