# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real passwords.

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB)
# ---------------------------------------------------------------------------
# Every form submission is stored here. On the VPS, create the database and a
# dedicated user first:
#
#   CREATE DATABASE gemadvisor CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'gemadvisor'@'localhost' IDENTIFIED BY 'a-long-random-password';
#   GRANT ALL PRIVILEGES ON gemadvisor.* TO 'gemadvisor'@'localhost';
#   FLUSH PRIVILEGES;
#
# Then create the tables:  npm run db:setup
# Check the connection:    npm run db:check

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=gemadvisor
MYSQL_PASSWORD=
MYSQL_DATABASE=gemadvisor

# ---------------------------------------------------------------------------
# Email alerts for new enquiries
# ---------------------------------------------------------------------------
# Alerts are sent through your own mailbox over SMTP. The submission is saved to
# the database either way — email is only the alert, so a mail problem never
# loses a lead.

# Create the mailbox in hPanel first, then use its address and password here.
# Port 465 = SSL. If your host blocks it, use 587 (STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=gem@gemgovadvisors.com
SMTP_PASSWORD=
# Optional display name. Must stay on a real mailbox of your domain.
# SMTP_FROM="GeM Advisor Website <gem@gemgovadvisors.com>"

# Who receives the alert. Defaults to SITE.email in src/data/site.js.
# Comma-separate for more than one recipient.
# LEAD_NOTIFY_EMAIL=gem@gemgovadvisors.com,sales@gemgovadvisors.com
